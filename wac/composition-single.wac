package example:composition; // targets wasi:http/service;

// Instantiate the `service` component
let srv = new my:service { ... };

// Instantiate the `middleware` component by plugging its `handle`
// import with the `handle` export of the `service` component.
let mdl = new my:middleware {
    "wasi:http/handler@0.3.0-rc-2026-01-06": srv["wasi:http/handler@0.3.0-rc-2026-01-06"], ...
};

// Export the `handle` function from the `middleware` component.
export mdl["wasi:http/handler@0.3.0-rc-2026-01-06"];
