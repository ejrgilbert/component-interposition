package example:composition;

let adder-comp = new my:adder-comp {
    ...
};

let adder-async-comp = new my:adder-async-comp {
    ...
};

let printer1-comp = new my:printer1-comp {
    ...
};

let printer1-async-comp = new my:printer1-async-comp {
    ...
};

let printer-n-comp = new my:printer-n-comp {
    ...
};

let printer-n-mdl-a = new my:printer-n-mdl-a { ... };

let printer-n-mdl-a-proxy = new my:printer-n-mdl-a-proxy {
    "my:service/printer-n": printer-n-comp["my:service/printer-n"],
    "splicer:proxy/before": printer-n-mdl-a["splicer:proxy/before"],
    "splicer:proxy/after": printer-n-mdl-a["splicer:proxy/after"],
    ...
};

let printer1-async-mdl-a = new my:printer1-async-mdl-a { ... };

let printer1-async-mdl-a-proxy = new my:printer1-async-mdl-a-proxy {
    "my:service/printer1-async": printer1-async-comp["my:service/printer1-async"],
    "splicer:proxy/before": printer1-async-mdl-a["splicer:proxy/before"],
    "splicer:proxy/after": printer1-async-mdl-a["splicer:proxy/after"],
    ...
};

let printer1-mdl-a = new my:printer1-mdl-a { ... };

let printer1-mdl-a-proxy = new my:printer1-mdl-a-proxy {
    "my:service/printer1": printer1-comp["my:service/printer1"],
    "splicer:proxy/before": printer1-mdl-a["splicer:proxy/before"],
    "splicer:proxy/after": printer1-mdl-a["splicer:proxy/after"],
    ...
};

let adder-async-mdl-a = new my:adder-async-mdl-a { ... };

let adder-async-mdl-a-proxy = new my:adder-async-mdl-a-proxy {
    "my:service/adder-async": adder-async-comp["my:service/adder-async"],
    "splicer:proxy/before": adder-async-mdl-a["splicer:proxy/before"],
    "splicer:proxy/after": adder-async-mdl-a["splicer:proxy/after"],
    ...
};

let adder-mdl-a = new my:adder-mdl-a { ... };

let adder-mdl-a-proxy = new my:adder-mdl-a-proxy {
    "my:service/adder": adder-comp["my:service/adder"],
    "splicer:proxy/before": adder-mdl-a["splicer:proxy/before"],
    "splicer:proxy/after": adder-mdl-a["splicer:proxy/after"],
    ...
};

let service-comp = new my:service-comp {
    "my:service/printer-n": printer-n-mdl-a-proxy["my:service/printer-n"],
    "my:service/printer1-async": printer1-async-mdl-a-proxy["my:service/printer1-async"],
    "my:service/printer1": printer1-mdl-a-proxy["my:service/printer1"],
    "my:service/adder-async": adder-async-mdl-a-proxy["my:service/adder-async"],
    "my:service/adder": adder-mdl-a-proxy["my:service/adder"],
    ...
};

export service-comp["wasi:http/handler@0.3.0-rc-2026-01-06"];