package example:composition;

let srv = new my:srv {
    ...
};

let mdl-c = new my:mdl-c { ... };

let mdl-c-adapter = new my:mdl-c-adapter {
    "wasi:http/handler@0.3.0-rc-2026-01-06": srv["wasi:http/handler@0.3.0-rc-2026-01-06"],
    "splicer:adapter/before": mdl-c["splicer:adapter/before"],
    "splicer:adapter/after": mdl-c["splicer:adapter/after"],
    ...
};

let mdl-b = new my:mdl-b { ... };

let mdl-b-adapter = new my:mdl-b-adapter {
    "wasi:http/handler@0.3.0-rc-2026-01-06": mdl-c-adapter["wasi:http/handler@0.3.0-rc-2026-01-06"],
    "splicer:adapter/before": mdl-b["splicer:adapter/before"],
    "splicer:adapter/after": mdl-b["splicer:adapter/after"],
    ...
};

let mdl-a = new my:mdl-a { ... };

let mdl-a-adapter = new my:mdl-a-adapter {
    "wasi:http/handler@0.3.0-rc-2026-01-06": mdl-b-adapter["wasi:http/handler@0.3.0-rc-2026-01-06"],
    "splicer:adapter/before": mdl-a["splicer:adapter/before"],
    "splicer:adapter/after": mdl-a["splicer:adapter/after"],
    ...
};

export mdl-a-adapter["wasi:http/handler@0.3.0-rc-2026-01-06"];