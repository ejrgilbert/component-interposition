let printer1-mdl-c-adapter = new my:printer1-mdl-c-adapter {
    "my:service/printer1": printer1-comp["my:service/printer1"],
    "splicer:tier1/before@0.1.0": printer1-mdl-c["splicer:tier1/before@0.1.0"],
