package my:service;

interface adder {
    add:            func(a: s32, b: s32) -> s32;
}
interface adder-async {
    add-async:      async func(a: s32, b: s32) -> s32;
}
interface messenger {
    get-msg:        func() -> string;
}
interface messenger-async {
    get-msg-async:  async func() -> string;
}
interface printer1 {
    print1:         func(msg: string);
}
interface printer1-async {
    print1-async:   async func(msg: string);
}
interface printer-n {
    print-n:        func(msg: string, n: u32);
}

/// Type-shape demo: one function per non-primitive shape.
interface shapes {
    enum priority { low, medium, high }
    enum color    { red, green, blue }
    pick-color:     func(p: priority) -> color;

    flags access-perms { read, write, execute }
    check-perms:    func(p: access-perms) -> bool;

    record person { name: string, age: u32 }
    greet:          func(p: person) -> string;

    variant event {
        click(s32),
        keypress(string),
        idle,
    }
    describe-event: func(e: event) -> string;

    swap-pair:      func(pair: tuple<s32, string>) -> tuple<string, s32>;
    maybe-double:   func(x: option<s32>) -> option<s32>;
    divide:         func(a: s32, b: s32) -> result<s32, string>;
    sum:            func(xs: list<s32>) -> s32;
    to-string:      func(c: char) -> string;

    /// Combo: record + option in args, result-of-list as return.
    /// Demonstrates that a single function can mix multiple shapes.
    aggregate:      func(p: person, scale: option<u32>) -> result<list<s32>, string>;
}

/// Factored types for `shapes-handles`. Resources are declared
/// here so splicer's wrapper-component pattern can preserve type
/// identity across the import/export boundary — declaring them
/// inline in `shapes-handles` would diverge type identities and
/// the runtime would reject crossing handles.
interface shapes-handles-types {
    /// Stateful resource with constructor + methods.
    resource counter {
        constructor(start: s32);
        increment: func();
        current: func() -> s32;
    }
}

/// Resource, future, and stream shapes.
interface shapes-handles {
    use shapes-handles-types.{counter};

    /// Returns a freshly-owned counter.
    make-counter:     func(start: s32) -> counter;
    /// Reads the current value through a borrowed handle.
    counter-current:  func(c: borrow<counter>) -> s32;
    /// Consumes the handle, returning its current value.
    consume-counter:  func(c: counter) -> s32;

    /// Returns a future that resolves to the sum.
    delayed-add:      func(a: s32, b: s32) -> future<s32>;

    /// Returns a stream that produces a countdown of integers.
    countdown:        func(start: s32) -> stream<s32>;
}

/// Factored types for `async-bucket`. The resource has to live in a
/// sibling types interface so splicer's wrapper-component pattern can
/// preserve resource type identity across the wrap boundary —
/// declaring it inline in `async-bucket` itself trips splicer's
/// inline-resource rejection at compose time.
interface async-bucket-types {
    resource bucket {
        constructor(seed: u32);
        get:  async func(key: u32) -> option<u32>;
        put:  async func(key: u32, val: u32);
    }
}

/// Async-only resource iface.
interface async-bucket {
    use async-bucket-types.{bucket};
    open:     async func(seed: u32) -> bucket;
}

/// Factored types for `bucket-as-arg`, distinct from
/// `async-bucket-types`. Keeping the resource identity local to its
/// own iface family lets us tier-4-wrap `bucket-as-arg` without
/// dragging in unrelated consumers of the bucket type.
interface bucket-as-arg-types {
    resource bucket {
        constructor(seed: u32);
        get:  async func(key: u32) -> option<u32>;
        put:  async func(key: u32, val: u32);
    }
}

interface bucket-as-arg {
    use bucket-as-arg-types.{bucket};
    get:     async func(b: bucket) -> string;
}
